<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Orçamento — Dicró Odontologia</title>
<style>
  :root{
    --navy:#0e2240;
    --navy-soft:#1b3a63;
    --gold:#c4a052;
    --gold-soft:#e8d9ad;
    --ink:#1d2733;
    --muted:#6c7a8c;
    --line:#dde4ec;
    --bg:#eef2f7;
    --paper:#ffffff;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{
    font-family:"Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif;
    background:var(--bg);color:var(--ink);line-height:1.45;
    padding:24px 12px;
  }
  .sheet{
    max-width:820px;margin:0 auto;background:var(--paper);
    border-radius:14px;overflow:hidden;
    box-shadow:0 12px 40px rgba(14,34,64,.12);
  }

  /* Cabeçalho */
  header{
    background:linear-gradient(135deg,var(--navy),var(--navy-soft));
    color:#fff;padding:26px 30px;position:relative;
  }
  header::after{content:"";position:absolute;left:0;right:0;bottom:0;height:4px;
    background:linear-gradient(90deg,var(--gold),var(--gold-soft));}
  .brand{display:flex;align-items:center;gap:16px;}
  .mark{
    width:52px;height:52px;border:2px solid var(--gold);border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    font-size:24px;font-weight:700;color:var(--gold);letter-spacing:.5px;flex-shrink:0;
  }
  .brand h1{font-size:22px;letter-spacing:1.5px;font-weight:600;}
  .brand p{font-size:12px;color:var(--gold-soft);letter-spacing:1px;text-transform:uppercase;margin-top:2px;}
  .clinic-info{font-size:11.5px;color:#c3d0e0;margin-top:14px;display:flex;flex-wrap:wrap;gap:4px 18px;}

  .body{padding:24px 30px 30px;}
  .doc-title{font-size:13px;letter-spacing:3px;text-transform:uppercase;color:var(--navy);
    font-weight:700;border-bottom:2px solid var(--gold);padding-bottom:8px;margin-bottom:18px;}

  /* Dados paciente */
  .patient{display:grid;grid-template-columns:1fr 1fr;gap:12px 20px;margin-bottom:22px;}
  .field{display:flex;flex-direction:column;gap:3px;}
  .field.full{grid-column:1/-1;}
  .field label{font-size:10.5px;letter-spacing:1px;text-transform:uppercase;color:var(--muted);font-weight:600;}
  .field input{border:none;border-bottom:1px solid var(--line);padding:6px 2px;font-size:14px;
    color:var(--ink);background:transparent;font-family:inherit;}
  .field input:focus{outline:none;border-bottom:2px solid var(--gold);}

  /* Seletor de procedimentos */
  .picker{border:1px solid var(--line);border-radius:10px;padding:16px;margin-bottom:20px;background:#fafcfe;}
  .picker h3{font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:var(--navy);margin-bottom:12px;}
  .picker-row{display:grid;grid-template-columns:1fr 90px 130px auto;gap:10px;align-items:end;}
  .picker-row .field input,.picker-row select{border:1px solid var(--line);border-radius:7px;padding:8px;background:#fff;}
  select{font-family:inherit;font-size:14px;color:var(--ink);width:100%;}
  .add-btn{background:var(--navy);color:#fff;border:none;border-radius:8px;padding:10px 18px;
    font-size:13px;font-weight:600;cursor:pointer;letter-spacing:.5px;white-space:nowrap;height:38px;}
  .add-btn:hover{background:var(--navy-soft);}

  /* Tabela */
  table{width:100%;border-collapse:collapse;margin-bottom:8px;}
  thead th{background:var(--navy);color:#fff;font-size:11px;letter-spacing:1px;text-transform:uppercase;
    padding:10px;text-align:left;font-weight:600;}
  thead th:last-child,thead th.num{text-align:right;}
  tbody td{padding:11px 10px;border-bottom:1px solid var(--line);font-size:14px;}
  tbody td.num{text-align:right;font-variant-numeric:tabular-nums;}
  tbody tr:nth-child(even){background:#f7fafd;}
  .del{background:none;border:none;color:#c0392b;cursor:pointer;font-size:16px;line-height:1;}
  .empty-row td{text-align:center;color:var(--muted);font-style:italic;padding:24px;}

  /* Total */
  .totals{display:flex;justify-content:flex-end;margin-top:6px;}
  .totals .box{min-width:280px;}
  .totals .line{display:flex;justify-content:space-between;padding:8px 10px;font-size:14px;}
  .totals .line.grand{background:linear-gradient(135deg,var(--navy),var(--navy-soft));color:#fff;
    border-radius:8px;font-size:18px;font-weight:700;margin-top:6px;}
  .totals .line.grand .num{color:var(--gold-soft);}

  /* Pagamento + observações */
  .extra{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:24px;}
  .extra .field textarea{border:1px solid var(--line);border-radius:8px;padding:8px;font-family:inherit;
    font-size:13px;resize:vertical;min-height:70px;}
  .extra .field textarea:focus{outline:none;border-color:var(--gold);}

  /* Assinatura + validade */
  .footer-doc{margin-top:30px;display:flex;justify-content:space-between;align-items:flex-end;gap:24px;}
  .sign{flex:1;text-align:center;}
  .sign .ln{border-top:1px solid var(--ink);margin-bottom:5px;}
  .sign small{font-size:11px;color:var(--muted);}
  .validity{font-size:11px;color:var(--muted);max-width:240px;}

  /* Barra de ações */
  .actions{position:sticky;bottom:0;background:var(--paper);border-top:1px solid var(--line);
    padding:14px 30px;display:flex;gap:10px;justify-content:flex-end;}
  .actions button{border:none;border-radius:8px;padding:11px 22px;font-size:14px;font-weight:600;cursor:pointer;font-family:inherit;}
  .btn-print{background:var(--gold);color:var(--navy);}
  .btn-print:hover{background:#d4af5e;}
  .btn-clear{background:#f0f3f7;color:var(--muted);}
  .btn-clear:hover{background:#e4e9ef;}

  @media(max-width:680px){
    .patient,.extra{grid-template-columns:1fr;}
    .picker-row{grid-template-columns:1fr 1fr;}
    .picker-row .add-btn{grid-column:1/-1;}
    .totals .box{min-width:100%;}
  }

  /* IMPRESSÃO */
  @media print{
    body{background:#fff;padding:0;}
    .sheet{box-shadow:none;border-radius:0;max-width:100%;}
    .actions,.picker,.del,.add-btn{display:none!important;}
    thead th:last-child{display:none;}
    tbody td:last-child{display:none;}
    .field input,textarea{border:none;}
    @page{margin:14mm;}
  }
</style>
</head>
<body>
<div class="sheet">
  <header>
    <div class="brand">
      <div class="mark">D</div>
      <div>
        <h1>DICRÓ ODONTOLOGIA</h1>
        <p>Especializada</p>
      </div>
    </div>
    <div class="clinic-info">
      <span>Dra. Joice Dicró · CRO-RJ 055701</span>
      <span>Praça João Luiz do Nascimento, 28 — Loja 2, Mesquita/RJ</span>
      <span>WhatsApp (21) 97160-0874</span>
      <span>@dicro.odontologia</span>
    </div>
  </header>

  <div class="body">
    <div class="doc-title">Orçamento de Tratamento</div>

    <!-- Dados do paciente -->
    <div class="patient">
      <div class="field full"><label>Nome do paciente</label><input type="text" id="pNome"></div>
      <div class="field"><label>Data</label><input type="date" id="pData"></div>
      <div class="field"><label>Telefone</label><input type="text" id="pTel" placeholder="(21) "></div>
    </div>

    <!-- Seletor -->
    <div class="picker">
      <h3>Adicionar procedimento</h3>
      <div class="picker-row">
        <div class="field">
          <label>Procedimento</label>
          <select id="selProc"></select>
        </div>
        <div class="field">
          <label>Dente / Região</label>
          <input type="text" id="selDente" placeholder="Ex: 11">
        </div>
        <div class="field">
          <label>Valor (R$)</label>
          <input type="number" id="selValor" step="0.01" min="0" placeholder="0,00">
        </div>
        <button class="add-btn" onclick="addItem()">+ Adicionar</button>
      </div>
    </div>

    <!-- Tabela -->
    <table>
      <thead>
        <tr>
          <th style="width:48px">#</th>
          <th>Procedimento</th>
          <th style="width:110px">Dente/Região</th>
          <th class="num" style="width:130px">Valor</th>
          <th style="width:40px"></th>
        </tr>
      </thead>
      <tbody id="tbody">
        <tr class="empty-row"><td colspan="5">Nenhum procedimento adicionado ainda.</td></tr>
      </tbody>
    </table>

    <!-- Totais -->
    <div class="totals">
      <div class="box">
        <div class="line"><span>Subtotal</span><span class="num" id="subtotal">R$ 0,00</span></div>
        <div class="line">
          <span>Desconto (R$)</span>
          <span class="num"><input type="number" id="desconto" value="0" step="0.01" min="0" style="width:90px;border:1px solid var(--line);border-radius:6px;padding:4px;text-align:right;" oninput="render()"></span>
        </div>
        <div class="line grand"><span>TOTAL</span><span class="num" id="total">R$ 0,00</span></div>
      </div>
    </div>

    <!-- Forma de pagamento + observações -->
    <div class="extra">
      <div class="field">
        <label>Forma de pagamento</label>
        <textarea id="pagto" placeholder="Ex: à vista no PIX, ou em até 6x no cartão..."></textarea>
      </div>
      <div class="field">
        <label>Observações</label>
        <textarea id="obs" placeholder="Plano de tratamento, sequência, etc."></textarea>
      </div>
    </div>

    <!-- Assinatura -->
    <div class="footer-doc">
      <div class="validity">Orçamento válido por 30 dias a partir da data de emissão. Os valores podem ser revistos após avaliação clínica.</div>
      <div class="sign">
        <div class="ln"></div>
        <small>Dra. Joice Dicró · CRO-RJ 055701</small>
      </div>
    </div>
  </div>

  <div class="actions">
    <button class="btn-clear" onclick="limpar()">Limpar tudo</button>
    <button class="btn-print" onclick="imprimir()">🖨 Imprimir orçamento</button>
  </div>
</div>

<script>
  // Lista de procedimentos pré-carregada
  const procedimentos = [
    "— Selecione —",
    "Consulta odontológica",
    "Documentação ortodôntica",
    "Instalação de aparelho ortodôntico fixo",
    "Manutenção de aparelho ortodôntico",
    "Aparelho ortodôntico móvel / contenção",
    "Aparelho ortodôntico estético",
    "Alinhador ortodôntico transparente",
    "Prótese total (dentadura)",
    "Prótese parcial removível",
    "Prótese fixa / coroa unitária",
    "Prótese sobre implante",
    "Implante dentário unitário",
    "Enxerto ósseo",
    "Restauração em resina",
    "Tratamento de canal (endodontia)",
    "Extração dentária simples",
    "Extração de siso",
    "Limpeza / profilaxia",
    "Raspagem periodontal",
    "Clareamento dental (consultório)",
    "Clareamento dental (caseiro)",
    "Faceta / lente de contato dental",
    "Radiografia panorâmica",
    "Harmonização orofacial"
  ];

  let itens = [];

  // Popular o select
  const sel = document.getElementById('selProc');
  procedimentos.forEach((p,i)=>{
    const o=document.createElement('option');
    o.value = i===0 ? "" : p;
    o.textContent = p;
    sel.appendChild(o);
  });

  // Data de hoje
  document.getElementById('pData').valueAsDate = new Date();

  function brl(v){return "R$ " + (v||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});}

  function addItem(){
    const proc = document.getElementById('selProc').value;
    const dente = document.getElementById('selDente').value.trim();
    const valor = parseFloat(document.getElementById('selValor').value)||0;
    if(!proc){alert('Selecione um procedimento.');return;}
    itens.push({proc,dente:dente||"—",valor});
    document.getElementById('selProc').value="";
    document.getElementById('selDente').value="";
    document.getElementById('selValor').value="";
    document.getElementById('selProc').focus();
    render();
  }

  function delItem(i){itens.splice(i,1);render();}

  function render(){
    const tb=document.getElementById('tbody');
    tb.innerHTML="";
    if(itens.length===0){
      tb.innerHTML='<tr class="empty-row"><td colspan="5">Nenhum procedimento adicionado ainda.</td></tr>';
    }else{
      itens.forEach((it,i)=>{
        const tr=document.createElement('tr');
        tr.innerHTML=`<td>${i+1}</td><td>${it.proc}</td><td>${it.dente}</td>`+
          `<td class="num">${brl(it.valor)}</td>`+
          `<td><button class="del" onclick="delItem(${i})" title="Remover">✕</button></td>`;
        tb.appendChild(tr);
      });
    }
    const sub=itens.reduce((s,i)=>s+i.valor,0);
    const desc=parseFloat(document.getElementById('desconto').value)||0;
    document.getElementById('subtotal').textContent=brl(sub);
    document.getElementById('total').textContent=brl(Math.max(0,sub-desc));
  }

  function imprimir(){
    // Tenta impressão direta; se o ambiente bloquear, gera janela própria.
    try{
      if(window.self===window.top){
        window.print();
        return;
      }
    }catch(e){}
    gerarJanelaImpressao();
  }

  function gerarJanelaImpressao(){
    const fmt=d=>{if(!d)return"—";const[a,m,di]=d.split('-');return `${di}/${m}/${a}`;};
    const nome=document.getElementById('pNome').value||"—";
    const data=fmt(document.getElementById('pData').value);
    const tel=document.getElementById('pTel').value||"—";
    const desc=parseFloat(document.getElementById('desconto').value)||0;
    const sub=itens.reduce((s,i)=>s+i.valor,0);
    const tot=Math.max(0,sub-desc);
    const pagto=document.getElementById('pagto').value||"—";
    const obs=document.getElementById('obs').value||"—";

    let linhas=itens.map((it,i)=>
      `<tr><td>${i+1}</td><td>${it.proc}</td><td>${it.dente}</td><td style="text-align:right">${brl(it.valor)}</td></tr>`
    ).join("");
    if(!linhas)linhas='<tr><td colspan="4" style="text-align:center;color:#888">Nenhum procedimento.</td></tr>';

    const html=`<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><title>Orçamento — Dicró</title>
    <style>
      body{font-family:"Segoe UI",Arial,sans-serif;color:#1d2733;margin:0;padding:24px;}
      .hd{background:#0e2240;color:#fff;padding:20px 24px;border-bottom:4px solid #c4a052;}
      .hd h1{margin:0;font-size:20px;letter-spacing:1.5px;}
      .hd p{margin:2px 0 0;font-size:11px;color:#e8d9ad;letter-spacing:1px;text-transform:uppercase;}
      .hd .info{font-size:11px;color:#c3d0e0;margin-top:10px;line-height:1.6;}
      .ct{padding:24px;}
      .pat{margin-bottom:18px;font-size:14px;line-height:1.8;}
      .pat b{color:#0e2240;}
      table{width:100%;border-collapse:collapse;margin-bottom:14px;}
      th{background:#0e2240;color:#fff;font-size:11px;text-transform:uppercase;padding:9px;text-align:left;}
      td{padding:9px;border-bottom:1px solid #dde4ec;font-size:13px;}
      .tot{text-align:right;font-size:14px;line-height:1.9;}
      .tot .g{font-size:18px;font-weight:700;color:#0e2240;}
      .ex{margin-top:18px;font-size:13px;line-height:1.7;}
      .ex b{color:#0e2240;}
      .sg{margin-top:46px;text-align:center;}
      .sg .ln{border-top:1px solid #1d2733;width:280px;margin:0 auto 5px;}
      .sg small{font-size:11px;color:#6c7a8c;}
      .vl{font-size:10.5px;color:#6c7a8c;margin-top:24px;}
      @page{margin:14mm;}
    </style></head><body>
    <div class="hd">
      <h1>DICRÓ ODONTOLOGIA</h1><p>Especializada</p>
      <div class="info">Dra. Joice Dicró · CRO-RJ 055701<br>
      Praça João Luiz do Nascimento, 28 — Loja 2, Mesquita/RJ · WhatsApp (21) 97160-0874 · @dicro.odontologia</div>
    </div>
    <div class="ct">
      <div class="pat"><b>Paciente:</b> ${nome} &nbsp;&nbsp; <b>Data:</b> ${data} &nbsp;&nbsp; <b>Telefone:</b> ${tel}</div>
      <table><thead><tr><th style="width:40px">#</th><th>Procedimento</th><th style="width:110px">Dente/Região</th><th style="width:120px;text-align:right">Valor</th></tr></thead>
      <tbody>${linhas}</tbody></table>
      <div class="tot">
        Subtotal: ${brl(sub)}<br>
        Desconto: ${brl(desc)}<br>
        <span class="g">TOTAL: ${brl(tot)}</span>
      </div>
      <div class="ex"><b>Forma de pagamento:</b> ${pagto}<br><b>Observações:</b> ${obs}</div>
      <div class="sg"><div class="ln"></div><small>Dra. Joice Dicró · CRO-RJ 055701</small></div>
      <div class="vl">Orçamento válido por 30 dias a partir da data de emissão. Os valores podem ser revistos após avaliação clínica.</div>
    </div>
    <script>window.onload=function(){window.print();}<\/script>
    </body></html>`;

    const w=window.open('','_blank');
    if(!w){alert('Permita pop-ups para imprimir, ou abra o arquivo direto no navegador.');return;}
    w.document.write(html);
    w.document.close();
  }

  function limpar(){
    if(!confirm('Limpar todos os dados deste orçamento?'))return;
    itens=[];
    document.getElementById('pNome').value="";
    document.getElementById('pTel').value="";
    document.getElementById('desconto').value="0";
    document.getElementById('pagto').value="";
    document.getElementById('obs').value="";
    document.getElementById('pData').valueAsDate=new Date();
    render();
  }

  render();
</script>
</body>
</html>
