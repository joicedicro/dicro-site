<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dicró Odontologia – Links</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=Inter:wght@400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy: #1B2A4A;
      --gold: #C9A24B;
      --gold-light: #e2c07a;
      --cream: #FAF8F4;
      --text: #2c2c2c;
    }

    body {
      min-height: 100dvh;
      background: var(--navy);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem 1.25rem;
      font-family: 'Inter', sans-serif;
    }

    /* Fundo com textura sutil */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 80% 60% at 50% 0%, rgba(201,162,75,0.10) 0%, transparent 70%),
        radial-gradient(ellipse 60% 40% at 50% 100%, rgba(201,162,75,0.06) 0%, transparent 70%);
      pointer-events: none;
    }

    .card {
      position: relative;
      width: 100%;
      max-width: 400px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.75rem;
    }

    /* Logo + nome */
    .brand {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    .logo-ring {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      border: 2px solid var(--gold);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--navy);
    }

    .logo-ring img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .logo-fallback {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2rem;
      font-weight: 600;
      color: var(--gold);
      letter-spacing: 0.05em;
    }

    .brand-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.5rem;
      font-weight: 600;
      color: var(--cream);
      letter-spacing: 0.04em;
      text-align: center;
    }

    .brand-tagline {
      font-size: 0.75rem;
      color: var(--gold);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      text-align: center;
    }

    /* Divisor dourado */
    .divider {
      width: 40px;
      height: 1px;
      background: var(--gold);
      opacity: 0.5;
    }

    /* Botões */
    .links {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      width: 100%;
    }

    .link-btn {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      width: 100%;
      padding: 1rem 1.25rem;
      border-radius: 10px;
      text-decoration: none;
      border: 1px solid rgba(201,162,75,0.25);
      transition: background 0.2s, border-color 0.2s, transform 0.15s;
      -webkit-tap-highlight-color: transparent;
    }

    .link-btn:active {
      transform: scale(0.98);
    }

    .link-btn.primary {
      background: var(--gold);
      border-color: var(--gold);
    }

    .link-btn.primary:hover {
      background: var(--gold-light);
      border-color: var(--gold-light);
    }

    .link-btn.secondary {
      background: rgba(255,255,255,0.05);
    }

    .link-btn.secondary:hover {
      background: rgba(255,255,255,0.09);
      border-color: rgba(201,162,75,0.5);
    }

    .btn-icon {
      font-size: 1.4rem;
      flex-shrink: 0;
      width: 28px;
      text-align: center;
    }

    .btn-text {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
    }

    .btn-label {
      font-size: 0.95rem;
      font-weight: 500;
      line-height: 1.2;
    }

    .btn-sub {
      font-size: 0.72rem;
      opacity: 0.75;
      letter-spacing: 0.02em;
    }

    .link-btn.primary .btn-label,
    .link-btn.primary .btn-sub {
      color: var(--navy);
    }

    .link-btn.secondary .btn-label {
      color: var(--cream);
    }

    .link-btn.secondary .btn-sub {
      color: var(--gold-light);
    }

    /* Footer */
    .footer {
      font-size: 0.68rem;
      color: rgba(255,255,255,0.25);
      letter-spacing: 0.06em;
      text-align: center;
    }

    @media (prefers-reduced-motion: reduce) {
      .link-btn { transition: none; }
    }
  </style>
</head>
<body>
  <div class="card">

    <div class="brand">
      <div class="logo-ring">
        <span class="logo-fallback">D</span>
      </div>
      <div class="brand-name">Dicró Odontologia</div>
      <div class="brand-tagline">Especializada · Mesquita – RJ</div>
    </div>

    <div class="divider"></div>

    <div class="links">

      <a class="link-btn primary"
         href="https://app.simplesdental.com/simples/agendamento/dicro"
         target="_blank" rel="noopener">
        <span class="btn-icon">📅</span>
        <div class="btn-text">
          <span class="btn-label">Agendar consulta online</span>
          <span class="btn-sub">Escolha dia e horário agora</span>
        </div>
      </a>

      <a class="link-btn secondary"
         href="https://wa.me/5521971600874"
         target="_blank" rel="noopener">
        <span class="btn-icon">💬</span>
        <div class="btn-text">
          <span class="btn-label">Falar pelo WhatsApp</span>
          <span class="btn-sub">Tire dúvidas antes de agendar</span>
        </div>
      </a>

      <a class="link-btn secondary"
         href="https://maps.app.goo.gl/R1aXGXSRNLP4S7yN9"
         target="_blank" rel="noopener">
        <span class="btn-icon">📍</span>
        <div class="btn-text">
          <span class="btn-label">Como chegar</span>
          <span class="btn-sub">Praça João Luiz do Nascimento, 28 – Mesquita</span>
        </div>
      </a>

      <a class="link-btn secondary"
         href="https://dicro.com.br"
         target="_blank" rel="noopener">
        <span class="btn-icon">🌐</span>
        <div class="btn-text">
          <span class="btn-label">Nosso site</span>
          <span class="btn-sub">Tratamentos, equipe e muito mais</span>
        </div>
      </a>

    </div>

    <div class="footer">dicro.com.br</div>

  </div>
</body>
</html>
